# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/storage/*

# AgentHub demo database and editable skill packages are versioned assets.
!/storage/agenthub/
!/storage/agenthub/skills/
!/storage/agenthub/skills/**
!/storage/agenthub/agenthub.db
/storage/agenthub/*.db-shm
/storage/agenthub/*.db-wal
!/storage/agenthub/.gitkeep

# KnowHub demo snapshot is versioned; SQLite sidecar files remain runtime-only.
!/storage/knowhub/
!/storage/knowhub/**
/storage/knowhub/**/*.db-*
/storage/knowhub/**/*.sqlite-*

# AppFactory workspaces, sessions, builds and transcripts are local runtime data.
!/storage/appfactory/
/storage/appfactory/*
/storage/appfactory/**/workspaces/
/storage/appfactory/**/sessions/
/storage/appfactory/pi-sessions/
/storage/appfactory/**/builds/
/storage/appfactory/**/runtime/
/storage/appfactory/transcripts/
!/storage/appfactory/.gitkeep

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
reference/

.antigravitycli/
docs/superpowers/
